{
  "info": {
    "_postman_id": "b9c70768-40a2-41e2-95b4-6c9db74f9041",
    "name": "Clima API",
    "description": "Esta es nuestra colección de endpoints de Clima-API. Configura `baseUrl` si la app no corre en localhost:8080. Para usar los endpoints de clima, recomendaciones, favoritos e historial se necesita iniciar sesion primero con Auth > Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login exitoso\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.idUsuario) {",
                  "  pm.collectionVariables.set(\"usuarioId\", body.idUsuario);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usuario@test.com\",\n  \"contrasena\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesion y deja la cookie de sesion guardada automaticamente por Postman."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Cierra la sesion actual."
          }
        }
      ]
    },
